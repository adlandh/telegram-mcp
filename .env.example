# Copy to .env, fill in values from https://my.telegram.org/apps.
# Load explicitly: set -a; . ./.env; set +a
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_32_hex_characters
TELEGRAM_PHONE=+491234567890

# Optional. ~/ is expanded by the application.
TELEGRAM_SESSION_PATH=~/.telegram-mcp/session.json
TELEGRAM_DOWNLOAD_DIR=~/.telegram-mcp/downloads
TELEGRAM_MAX_DOWNLOAD_MB=200
TELEGRAM_REQUEST_TIMEOUT=5m
